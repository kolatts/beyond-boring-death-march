{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "npcs.schema.json",
  "title": "Landmark NPC Encounters",
  "type": "array",
  "minItems": 14,
  "maxItems": 14,
  "items": {
    "type": "object",
    "required": ["id", "landmarkId", "name", "intro", "advice", "options"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^npc_[a-z][a-z0-9_]*$" },
      "landmarkId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "name": { "type": "string", "minLength": 1 },
      "intro": { "type": "string", "minLength": 1 },
      "advice": {
        "type": "object",
        "required": ["correct", "wrong"],
        "additionalProperties": false,
        "properties": {
          "correct": { "type": "string", "minLength": 1 },
          "wrong": { "type": "string", "minLength": 1 }
        }
      },
      "options": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": ["id", "label", "response", "effects"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "label": { "type": "string", "minLength": 1 },
            "response": { "type": "string", "minLength": 1 },
            "effects": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "credibility": { "type": "number" },
                "morale": { "type": "number" },
                "tokens": { "type": "number" },
                "trust": { "type": "number" },
                "context": { "type": "number" },
                "days": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
