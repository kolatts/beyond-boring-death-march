{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mandatory Compliance Notice (spec §17 easter egg)",
  "type": "object",
  "required": ["heading", "docLine", "sections", "closing"],
  "additionalProperties": false,
  "properties": {
    "heading": { "type": "string", "minLength": 1 },
    "docLine": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "body"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "closing": { "type": "string", "minLength": 1 }
  }
}
