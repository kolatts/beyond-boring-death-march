{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skills-market.schema.json",
  "title": "Skills Exchange scene flavor",
  "type": "object",
  "required": ["intro", "typeSigns", "proprietor", "championIntercept"],
  "additionalProperties": false,
  "properties": {
    "intro": { "type": "string", "minLength": 1 },
    "typeSigns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["type", "name", "sign"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["procedure", "scout", "standing_order", "trade_route"]
          },
          "name": { "type": "string", "minLength": 1 },
          "sign": { "type": "string", "minLength": 1 }
        }
      }
    },
    "proprietor": {
      "type": "object",
      "required": ["greeting", "genericSale", "trapProcedureSale", "trapRouteChampionDead"],
      "additionalProperties": false,
      "properties": {
        "greeting": { "type": "string", "minLength": 1 },
        "genericSale": { "type": "string", "minLength": 1 },
        "trapProcedureSale": { "type": "string", "minLength": 1 },
        "trapRouteChampionDead": { "type": "string", "minLength": 1 }
      }
    },
    "championIntercept": { "type": "string", "minLength": 1 }
  }
}
