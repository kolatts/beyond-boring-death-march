{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "loop-builder.schema.json",
  "title": "Loop Builder content (spec 7.2, v2 socket ring)",
  "type": "object",
  "required": ["comment", "nodes", "checks", "stops", "run", "fork", "ridge", "tutorial", "verdicts"],
  "additionalProperties": false,
  "definitions": {
    "node": {
      "type": "object",
      "required": ["label", "sub", "desc"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 16 },
        "sub": { "type": "string", "minLength": 1, "maxLength": 24 },
        "desc": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "graphNode": {
      "type": "object",
      "required": ["label", "desc"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 16 },
        "desc": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "lines": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "properties": {
    "comment": { "type": "string" },
    "nodes": {
      "type": "object",
      "required": ["trigger", "agent", "stop", "gate"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "$ref": "#/definitions/node" },
        "agent": { "$ref": "#/definitions/node" },
        "stop": { "$ref": "#/definitions/node" },
        "gate": { "$ref": "#/definitions/node" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "sub", "desc", "passLine", "failLine", "closerLine", "feedbackLine"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["run_build", "run_lint", "run_ui_tests", "squint"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 16 },
          "sub": { "type": "string", "minLength": 1, "maxLength": 24 },
          "desc": { "type": "string", "minLength": 1, "maxLength": 160 },
          "passLine": { "type": "string", "minLength": 1 },
          "failLine": { "type": "string", "minLength": 1 },
          "closerLine": { "type": "string", "minLength": 1 },
          "feedbackLine": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "sub", "desc"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["cap", "budget", "both", "none"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 16 },
          "sub": { "type": "string", "minLength": 1, "maxLength": 24 },
          "desc": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["start", "triggerLine", "agentLines", "stopLine", "squintPassLine", "gateEscortLine", "scoreLine"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "triggerLine": { "type": "string" },
        "agentLines": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "stopLine": { "type": "string" },
        "squintPassLine": { "type": "string" },
        "gateEscortLine": { "type": "string" },
        "scoreLine": { "type": "string" }
      }
    },
    "fork": {
      "type": "object",
      "required": ["title", "intro", "graph", "loop", "tally", "banner", "moral"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "intro": { "$ref": "#/definitions/lines" },
        "graph": {
          "type": "object",
          "required": ["hint", "nodes", "doneLabel", "runA", "runB", "verdict"],
          "additionalProperties": false,
          "properties": {
            "hint": { "type": "string" },
            "nodes": {
              "type": "object",
              "required": ["plan", "step_a", "step_b", "merge"],
              "additionalProperties": false,
              "properties": {
                "plan": { "$ref": "#/definitions/graphNode" },
                "step_a": { "$ref": "#/definitions/graphNode" },
                "step_b": { "$ref": "#/definitions/graphNode" },
                "merge": { "$ref": "#/definitions/graphNode" }
              }
            },
            "doneLabel": { "type": "string", "minLength": 1, "maxLength": 12 },
            "runA": { "$ref": "#/definitions/lines" },
            "runB": { "$ref": "#/definitions/lines" },
            "verdict": { "type": "string" }
          }
        },
        "loop": {
          "type": "object",
          "required": ["hint", "runA", "runB", "verdict"],
          "additionalProperties": false,
          "properties": {
            "hint": { "type": "string" },
            "runA": { "$ref": "#/definitions/lines" },
            "runB": { "$ref": "#/definitions/lines" },
            "verdict": { "type": "string" }
          }
        },
        "tally": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "banner": { "type": "string" },
        "moral": { "type": "string" }
      }
    },
    "ridge": {
      "type": "object",
      "required": ["intro", "plate", "retreatDenied", "squintDenied", "crossSuccess", "crossGated", "banked"],
      "additionalProperties": false,
      "properties": {
        "intro": { "type": "string" },
        "plate": { "type": "string" },
        "retreatDenied": { "type": "string" },
        "squintDenied": { "type": "string" },
        "crossSuccess": { "$ref": "#/definitions/lines" },
        "crossGated": { "type": "string" },
        "banked": { "type": "string" }
      }
    },
    "tutorial": {
      "type": "object",
      "required": ["prompt", "fires", "ceremony", "loopIntro", "loopLines", "banner", "moral"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string" },
        "fires": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "ceremony": { "type": "string" },
        "loopIntro": { "type": "string" },
        "loopLines": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "banner": { "type": "string" },
        "moral": { "type": "string" }
      }
    },
    "verdicts": {
      "type": "object",
      "required": [
        "success",
        "no_verifier",
        "subjective_verifier",
        "no_stop_cap",
        "no_stop_budget",
        "human_gate_everywhere",
        "incomplete"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "object",
          "required": ["banner"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" }
          }
        },
        "no_verifier": {
          "type": "object",
          "required": ["banner", "cause", "checks", "lines"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" },
            "cause": { "type": "string" },
            "checks": { "type": "array", "minItems": 5, "items": { "type": "string" } },
            "lines": { "$ref": "#/definitions/lines" }
          }
        },
        "subjective_verifier": {
          "type": "object",
          "required": ["banner", "cause", "lines", "drain"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" },
            "cause": { "type": "string" },
            "lines": { "type": "array", "minItems": 3, "items": { "type": "string" } },
            "drain": { "type": "string" }
          }
        },
        "no_stop_cap": {
          "type": "object",
          "required": ["banner", "cause", "iterLine", "iterVariants", "watch", "lines", "breaker"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" },
            "cause": { "type": "string" },
            "iterLine": { "type": "string" },
            "iterVariants": { "$ref": "#/definitions/lines" },
            "watch": { "type": "string" },
            "lines": { "$ref": "#/definitions/lines" },
            "breaker": {
              "type": "object",
              "required": ["banner", "lines"],
              "additionalProperties": false,
              "properties": {
                "banner": { "type": "string" },
                "lines": { "$ref": "#/definitions/lines" }
              }
            }
          }
        },
        "no_stop_budget": {
          "type": "object",
          "required": ["banner", "cause", "lines", "invoice", "after"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" },
            "cause": { "type": "string" },
            "lines": { "$ref": "#/definitions/lines" },
            "invoice": { "type": "array", "minItems": 3, "items": { "type": "string" } },
            "after": { "type": "string" }
          }
        },
        "human_gate_everywhere": {
          "type": "object",
          "required": ["banner", "lines"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" },
            "lines": { "type": "array", "minItems": 4, "items": { "type": "string" } }
          }
        },
        "incomplete": {
          "type": "object",
          "required": ["banner", "missingStop"],
          "additionalProperties": false,
          "properties": {
            "banner": { "type": "string" },
            "missingStop": { "type": "string" }
          }
        }
      }
    }
  }
}
