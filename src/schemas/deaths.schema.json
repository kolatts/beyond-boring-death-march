{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deaths.schema.json",
  "title": "Deaths",
  "type": "array",
  "minItems": 25,
  "items": {
    "type": "object",
    "required": ["id", "cause", "text"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "cause": {
        "type": "string",
        "enum": ["context", "tokens", "trust", "morale", "loop", "deadline", "generic"]
      },
      "text": { "type": "string", "minLength": 1 }
    }
  }
}
