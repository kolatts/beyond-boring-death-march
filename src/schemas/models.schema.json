{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "models.schema.json",
  "title": "Model Cards",
  "type": "array",
  "minItems": 4,
  "items": {
    "type": "object",
    "required": ["id", "name", "reasoning", "speed", "costPerMile", "adherence", "blurb"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "name": { "type": "string", "minLength": 1 },
      "reasoning": { "type": "number", "minimum": 0, "maximum": 10 },
      "speed": { "type": "number", "minimum": 0, "maximum": 10 },
      "costPerMile": { "type": "number", "minimum": 0 },
      "adherence": { "type": "number", "minimum": 0, "maximum": 10 },
      "blurb": { "type": "string", "minLength": 1 }
    }
  }
}
